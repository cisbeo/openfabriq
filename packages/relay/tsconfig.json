{
	"compilerOptions": {
		"target": "ES2024",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2024"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["./worker-configuration.d.ts", "@cloudflare/vitest-plugin/types"]
	},
	"include": ["src", "test", "vitest.config.ts"]
}
